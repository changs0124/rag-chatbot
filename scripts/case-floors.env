# 케이스 수 하한(래칫) - 4단계 CI 게이트
#
# 규칙
# - 테스트를 늘린 PR 은 **그 시점 실측 케이스 수**로 하한을 함께 올림. 예상값·목표값을 적지 않음
#   (올리지 않으면 새로 넣은 케이스가 래칫의 보호를 못 받아 조용히 지워질 수 있음)
# - 내릴 때는 "무엇이 줄었는지"를 `docs/06_changelog/CHANGELOG.md` 에 적음 - 검사 대상이 줄어
#   케이스가 준 것과 테스트를 지운 것은 숫자만으로 구분되지 않음
# - skip 케이스는 세지 않음

BACKEND_MIN=185
FRONTEND_MIN=76
