+				.body(new ApiError("BAD_REQUEST", "요청 본문을 읽을 수 없음 (JSON 형식과 인코딩을 확인할 것)"));
+	}
+
+	/**
+	 * 경로·쿼리 변수의 타입이 어긋남 - UUID 자리에 UUID 가 아닌 값이 온 경우 등.
