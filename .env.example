# compose 전용 환경변수 예시 - 실제 값은 커밋하지 않음(.env 는 .gitignore 대상)
#
# **앱 변수는 여기가 아니라 backend/.env 에 넣는다.** 정본은 backend/.env.example 이며
# APP_MODE · JWT_SECRET · ALLOWED_ORIGINS · OPENAI_* 등이 그쪽 소관이다.
# 이 파일은 컨테이너 바깥 배선 중 DB 자격(POSTGRES_*)만 담는다. 터널 토큰은 secrets/ 파일에 둔다(아래 #203).

# === DB ===
# 이 세 값으로 db 컨테이너가 초기화되고, 같은 값이 앱의 DB_URL/DB_USERNAME/DB_PASSWORD 로 조립된다.
# 따라서 backend/.env 의 DB_* 는 compose 배포에서 무시된다(docker-compose.yml 이 덮어씀).
#
# **최초 기동 이후에는 비밀번호를 바꿔도 반영되지 않는다** - postgres 이미지는 데이터 디렉터리가
# 비어 있을 때만 초기화하기 때문이다. 바꾸려면 DB 안에서 ALTER USER 를 하거나 볼륨을 지워야 한다.
POSTGRES_DB=ragchatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# 앱의 런타임 계정(#415). 위 POSTGRES_USER 는 슈퍼유저라 마이그레이션(Flyway)에만 쓰고, 앱은 DML 만 가진 이 계정으로 붙는다.
# **비우면 앱도 POSTGRES_USER 로 붙는다**(옛 구성). 넣기 전에 DB 안에 계정을 먼저 만든다 - SQL 은 backend.md 「배포」.
# 권한(테이블 DML · 시퀀스)은 앱이 기동할 때 Flyway afterMigrate 가 맞추므로 계정만 있으면 된다
APP_DB_USER=
APP_DB_PASSWORD=

# === 실행 프로필 ===
# docker-compose.yml 이 app 에 prod 를 기본으로 켠다 - prod + APP_MODE=mock 기동을 막는다(#305).
# 로컬에서 compose 로 목업을 띄울 때만 아래 줄의 주석을 풀어 비운다
# SPRING_PROFILES_ACTIVE=

# === Cloudflare Tunnel ===
# Cloudflare 대시보드 → Zero Trust → Networks → Tunnels 에서 터널을 만들면 주는 토큰.
# 공개 호스트명 ↔ 내부 주소 매핑도 거기서 하며, 내부 주소는 **http://app:8080** 이다
# (localhost 가 아니다 - cloudflared 는 별도 컨테이너라 compose 네트워크 이름으로 찾아간다).
#
# 이 토큰은 터널에 대한 완전한 접근 권한이다. 유출되면 제3자가 같은 주소로 트래픽을 받을 수 있다
#
# **여기에 넣지 않는다(#203).** 환경변수로 넘기면 `docker inspect` 출력에 평문으로 남는다.
# 같은 디렉터리의 `secrets/tunnel_token` 파일에 토큰만 한 줄로 넣는다 :
#   install -d -m 700 secrets && printf '%s' '<토큰>' > secrets/tunnel_token && chmod 644 secrets/tunnel_token
# (파일이 644 인 이유는 docker-compose.yml 하단 secrets 주석)
