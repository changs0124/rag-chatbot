# 백엔드 환경변수 예시 - 실제 값은 커밋하지 않음
# 값의 정본은 backend/src/main/resources/application.yml 이며 여기 없는 항목은 기본값을 씀
#
# ── 목업으로 띄우려면 ─────────────────────────────────────────
#   APP_MODE=mock · JWT_SECRET · DB_* 만 있으면 됨 (OpenAI 값 불필요)
# ── 실 연동으로 띄우려면 ──────────────────────────────────────
#   위에 더해 APP_MODE=live · OPENAI_API_KEY · OPENAI_VECTOR_STORE_ID
# ─────────────────────────────────────────────────────────────

# === 필수 ===

# 실행 모드 : mock | live. **기본값 없음** - 주지 않으면 기동에 실패함(AppModeGuard).
# 목업이 우연히 켜지는 경로를 없애려고 일부러 명시 옵트인으로 둠
APP_MODE=mock

# JWT 서명 시크릿. 32바이트 이상 임의 문자열을 쓸 것
#   생성 예 : openssl rand -base64 48
# 이 값을 바꾸면 발급된 토큰이 전부 무효가 됨(전 사용자 재로그인)
JWT_SECRET=

# DB 접속 정보 (PostgreSQL). URL 은 jdbc 스킴이어야 함 -
# 관리형 DB 가 주는 postgres://user:pass@host/db 형식을 그대로 넣으면 기동하지 않음
DB_URL=jdbc:postgresql://localhost:5432/ragchatbot
DB_USERNAME=postgres
DB_PASSWORD=

# 프론트 출처 (CORS). **배포 시 반드시 실제 도메인으로 바꿀 것** -
# 빠뜨리면 브라우저가 모든 API 호출을 차단해 화면이 전부 실패함.
# 여러 개는 쉼표로 구분 (예: https://myapp.vercel.app,https://www.myapp.com)
# 백엔드를 터널로 노출하는 데모 구성이라도 여기에 넣는 값은 **터널 주소가 아니라 화면의 출처**임
# (터널 주소는 프론트의 VITE_API_BASE_URL 쪽)
ALLOWED_ORIGINS=http://localhost:5173

# === live 모드에서만 필요 ===

# OpenAI API 키. 값은 여기에 적지 않고 배포 플랫폼의 시크릿으로 주입할 것
OPENAI_API_KEY=

# 공용 Vector Store ID (RAG 검색 대상). **비우면 file_search 없이 답변하며
# 출처가 늘 0건이라 전부 "자료 없음"으로 표시됨** - 기동은 정상적으로 됨
OPENAI_VECTOR_STORE_ID=

# 사용할 모델 (기본 gpt-4o)
# OPENAI_MODEL=gpt-4o

# === 선택 (기본값으로 동작함) ===

# 리슨 포트. 대부분의 PaaS 가 PORT 를 주입하므로 보통 건드리지 않음
# PORT=8080

# 첨부 저장 루트. **컨테이너 배포 시 영속 볼륨 경로를 줄 것** -
# 로컬 디스크라 컨테이너가 갈리면 업로드된 이미지가 사라짐
FILE_STORAGE_ROOT=./uploads

# 모델에 함께 보낼 이전 대화 이력의 토큰 예산. 0 에 가깝게 두면 매 턴 문맥이 초기화되고,
# 크게 두면 턴당 비용이 오름. 과거 이미지는 예산과 무관하게 재전송하지 않음
# CHAT_HISTORY_TOKEN_BUDGET=6000

# 유량 제어 (단일 인스턴스 전제 - 인스턴스가 늘면 실효 한도가 곱해짐)
# RATELIMIT_CHAT_PER_MINUTE=20
# RATELIMIT_LOGIN_PER_MINUTE=10
# CHAT_MAX_CONCURRENT_STREAMS=8
# CHAT_MAX_CONCURRENT_PER_USER=1

# 토큰 수명(분) · SSE 스트림 타임아웃(ms)
# JWT_EXPIRATION_MINUTES=120
# SSE_TIMEOUT_MS=600000

# 세션 슬라이딩 재발급 임계(분). 남은 수명이 이보다 적으면 응답 헤더 X-Refresh-Token 으로
# 새 토큰이 실려 오고 프론트가 자동 교체함. **0 으로 두면 기능이 꺼져** 종전처럼 고정 만료가 됨
# JWT_REFRESH_THRESHOLD_MINUTES=30

# 고아 첨부 회수 - 유예(분)와 주기(cron)
# ORPHAN_TTL_MINUTES=60
# ORPHAN_CLEANUP_CRON=0 0 * * * *
