# 백엔드 환경변수 예시 - 실제 값은 커밋하지 않음 (보관 위치는 docs/02_운영.md 접근 권한 표에 기록)
# 목업 모드에서는 아래 OpenAI 값이 없어도 동작함 (APP_MODE=mock)

# 실행 모드 : mock | live
APP_MODE=mock

# JWT 서명 시크릿 (필수) - 값은 여기에 적지 않고 보관 위치만 docs/02_운영.md에 기록
JWT_SECRET=

# OpenAI (live 모드에서만 필요) - 값은 여기에 적지 않음
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=

# 파일 저장 루트 (로컬/서버 디스크)
FILE_STORAGE_ROOT=./uploads

# DB 접속 정보 (기술 스택 1단계 확정 후 채움)
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=
