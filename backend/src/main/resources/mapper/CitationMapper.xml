<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ragchatbot.mapper.CitationMapper">

	<resultMap id="citationResult" type="com.ragchatbot.domain.Citation">
		<constructor>
			<idArg column="id" javaType="java.util.UUID"/>
			<arg column="message_id" javaType="java.util.UUID"/>
			<arg column="seq" javaType="_int"/>
			<arg column="source_name" javaType="java.lang.String"/>
			<arg column="snippet" javaType="java.lang.String"/>
			<arg column="uri" javaType="java.lang.String"/>
			<arg column="created_at" javaType="java.time.OffsetDateTime"/>
		</constructor>
	</resultMap>

	<insert id="insert" parameterType="com.ragchatbot.domain.Citation">
		insert into citations (id, message_id, seq, source_name, snippet, uri)
		values (#{id}, #{messageId}, #{seq}, #{sourceName}, #{snippet}, #{uri})
	</insert>

	<select id="findByMessage" resultMap="citationResult">
		select id, message_id, seq, source_name, snippet, uri, created_at
		from citations
		where message_id = #{messageId}
		order by seq asc
	</select>

</mapper>
