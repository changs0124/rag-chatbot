<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ragchatbot.repository.MessageRepository">

	<resultMap id="messageResult" type="com.ragchatbot.entity.Message">
		<constructor>
			<idArg column="id" javaType="java.util.UUID"/>
			<arg column="conversation_id" javaType="java.util.UUID"/>
			<arg column="role" javaType="java.lang.String"/>
			<arg column="content" javaType="java.lang.String"/>
			<arg column="status" javaType="java.lang.String"/>
			<!-- MyBatis 별칭 - `boolean`은 java.lang.Boolean 이라 레코드의 primitive 생성자를 못 찾음 -->
			<arg column="stopped" javaType="_boolean"/>
			<!-- 같은 이유로 별칭. 서버 타임아웃 표시(#84) - stopped 와 별개의 축임 -->
			<arg column="timed_out" javaType="_boolean"/>
			<!-- Integer(박스형) - null 이 "모르는 것"을 뜻하므로 _int 로 받으면 0 으로 뭉개짐 -->
			<arg column="input_tokens" javaType="java.lang.Integer"/>
			<arg column="output_tokens" javaType="java.lang.Integer"/>
			<arg column="created_at" javaType="java.time.OffsetDateTime"/>
		</constructor>
	</resultMap>

	<insert id="insert" parameterType="com.ragchatbot.entity.Message">
		insert into messages (id, conversation_id, role, content, status, stopped, timed_out,
		                      input_tokens, output_tokens)
		values (#{id}, #{conversationId}, #{role}, #{content}, #{status}, #{stopped}, #{timedOut},
		        #{inputTokens}, #{outputTokens})
	</insert>

	<select id="listByConversation" resultMap="messageResult">
		select id, conversation_id, role, content, status, stopped, timed_out,
		       input_tokens, output_tokens, created_at
		from messages
		where conversation_id = #{conversationId}
		order by created_at asc
	</select>

</mapper>
